@echo off
rem Prepares the repository for VS Code with three build configurations: Debug, RelWithDebInfo, Release
rem (the debug / relwithdebinfo / release presets from CMakePresets.json):
rem   1. configures each preset in build\<preset> (MSVC x64 + Ninja) and requests the CMake Tools file API
rem      so IntelliSense and build tasks work immediately without a configure from VS Code;
rem   2. writes .vscode\settings.json, tasks.json, launch.json, and extensions.json: CMake Tools on presets,
rem      clangd on the relwithdebinfo compile_commands.json, qmlls from the build Qt, configure / build /
rem      rebuild tasks, and a debug configuration for each build.
rem The MSVC flags that confuse clangd are removed by .clangd in the repository root.
rem RelWithDebInfo and Release use LTO: their presets enable CMAKE_INTERPROCEDURAL_OPTIMIZATION
rem for all targets, and CMakeLists.txt adds /GL and /LTCG.
rem .vscode files not created by this script are preserved as <name>.bak.
rem Usage: scripts\configure-vscode.bat
setlocal
cd /D "%~dp0\.."

set "GENERATED_BY=Generated by scripts/configure-vscode.bat"

for %%p in (debug relwithdebinfo release) do (
    echo.
    echo === cmake --preset %%p
    call :cmakeToolsQuery "build\%%p"
    call "%~dp0vsenv.cmd" cmake --preset %%p
    if errorlevel 1 goto :fail
)

set "PROJECT_NAME="
for /f "tokens=2 delims==" %%n in ('findstr /b /c:"CMAKE_PROJECT_NAME:STATIC=" "build\debug\CMakeCache.txt"') do set "PROJECT_NAME=%%n"
if not defined PROJECT_NAME (
    echo [configure-vscode] CMAKE_PROJECT_NAME not found in build\debug\CMakeCache.txt 1>&2
    goto :fail
)

rem qmlls comes from the same Qt as the build. The BipkiUI module directory (QML_IMPORT_PATH, set by
rem 3rdparty\bipki) comes from build\relwithdebinfo: that is the preset built by the default build task.
set "QT6_DIR="
for /f "tokens=2 delims==" %%d in ('findstr /b /c:"Qt6_DIR:PATH=" "build\relwithdebinfo\CMakeCache.txt"') do set "QT6_DIR=%%d"
set "QML_IMPORT_PATH="
for /f "tokens=2 delims==" %%i in ('findstr /b /c:"QML_IMPORT_PATH:STRING=" "build\relwithdebinfo\CMakeCache.txt"') do set "QML_IMPORT_PATH=%%i"
set "QMLLS="
if defined QT6_DIR for %%q in ("%QT6_DIR%\..\..\..\bin\qmlls.exe") do if exist "%%~fq" set "QMLLS=%%~fq"
if defined QMLLS set "QMLLS=%QMLLS:\=/%"
if not defined QMLLS echo [configure-vscode] qmlls.exe not found for Qt6_DIR "%QT6_DIR%", .qml files get the qmlls of the Qt Qml extension 1>&2

echo.
echo === .vscode
if not exist ".vscode" mkdir ".vscode"
for %%f in (settings.json tasks.json launch.json extensions.json) do call :backup ".vscode\%%f"

> ".vscode\settings.json" (
    echo // %GENERATED_BY%. Running the script again overwrites this file.
    echo {
    echo     // CMake Tools works with the presets of CMakePresets.json: Debug, RelWithDebInfo, Release.
    echo     "cmake.useCMakePresets": "always",
    echo     "cmake.useVsDeveloperEnvironment": "always",
    echo     "cmake.configureOnOpen": false,
    echo     "C_Cpp.intelliSenseEngine": "disabled",
    echo     "cmake.debugConfig": {
    echo         "console": "integratedTerminal"
    echo     },
    echo     // C/C++ IntelliSense takes include paths and flags from the active preset.
    echo     "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    echo     // clangd takes them from compile_commands.json of build/relwithdebinfo, the preset of the default build
    echo     // task: by itself clangd looks for compile_commands.json only in build and in the source folders.
    echo     "clangd.arguments": ["--compile-commands-dir=${workspaceFolder}/build/relwithdebinfo", "--background-index", "-j=8", "--completion-style=detailed", "--limit-results=0",],
    call :qmlls
    echo     "files.insertFinalNewline": true,
    echo     "files.trimFinalNewlines": true,
    echo     // Formatting on save with the .clang-format of the repository, by C/C++ or by clangd. The formatter
    echo     // is not pinned: C/C++ with IntelliSense disabled for clangd does not format.
    echo     "editor.formatOnSave": true,
    echo     "C_Cpp.clang_format_style": "file"
    echo }
)

> ".vscode\tasks.json" (
    echo // %GENERATED_BY%. Running the script again overwrites this file.
    echo {
    echo     "version": "2.0.0",
    echo     "tasks": [
    call :tasks debug Debug false ","
    call :tasks relwithdebinfo RelWithDebInfo true ","
    call :tasks release Release false ""
    echo     ]
    echo }
)

> ".vscode\launch.json" (
    echo // %GENERATED_BY%. Running the script again overwrites this file.
    echo {
    echo     "version": "0.2.0",
    echo     "configurations": [
    call :launch debug Debug
    call :launch relwithdebinfo RelWithDebInfo
    call :launch release Release
    echo         {
    echo             "name": "%PROJECT_NAME% (active CMake Tools preset)",
    echo             "type": "cppvsdbg",
    echo             "request": "launch",
    echo             "program": "${command:cmake.launchTargetPath}",
    echo             "args": [],
    echo             "cwd": "${command:cmake.launchTargetDirectory}",
    echo             "stopAtEntry": false,
    echo             "console": "integratedTerminal",
    echo             "environment": []
    echo         },
    echo         {
    echo             "name": "%PROJECT_NAME%: attach",
    echo             "type": "cppvsdbg",
    echo             "request": "attach",
    echo             "processId": "${command:pickProcess}"
    echo         }
    echo     ]
    echo }
)

> ".vscode\extensions.json" (
    echo // %GENERATED_BY%. Running the script again overwrites this file.
    echo {
    echo     "recommendations": [
    echo         "ms-vscode.cpptools",
    echo         "ms-vscode.cmake-tools",
    echo         "theqtcompany.qt-qml"
    echo     ]
    echo }
)

echo Wrote .vscode\settings.json, tasks.json, launch.json and extensions.json.
echo Reload the VS Code window (Developer: Reload Window) to apply them.
if /I %0 EQU "%~dpnx0" pause
exit /b 0

:fail
set "EXIT_CODE=%errorlevel%"
if "%EXIT_CODE%"=="0" set "EXIT_CODE=1"
if /I %0 EQU "%~dpnx0" pause
exit /b %EXIT_CODE%

rem :cmakeToolsQuery <build-directory> - requests the CMake Tools file API. When the folder opens, CMake Tools
rem takes the code model (include paths and IntelliSense flags) from the response to its request; without a response
rem it waits for its own configure. With "cmake.configureOnOpen": false, IntelliSense never receives the paths.
:cmakeToolsQuery
set "QUERY_DIR=%~1\.cmake\api\v1\query\client-vscode"
if not exist "%QUERY_DIR%" mkdir "%QUERY_DIR%"
> "%QUERY_DIR%\query.json" echo {"requests":[{"kind":"cache","version":2},{"kind":"codemodel","version":2},{"kind":"toolchains","version":1},{"kind":"cmakeFiles","version":1}]}
exit /b 0

rem :qmlls - Qt Qml extension settings: qmlls from the build Qt and the QML module directories of the build.
rem Without them the extension runs its own qmlls without import paths, and import BipkiUI cannot be resolved.
:qmlls
if not defined QMLLS exit /b 0
echo     // QML Language Server of the Qt used by the build. QML modules of the build, BipkiUI among them,
echo     // come from QML_IMPORT_PATH of build/relwithdebinfo.
echo     "qt-qml.qmlls.customExePath": "%QMLLS%",
if defined QML_IMPORT_PATH echo     "qt-qml.qmlls.additionalImportPaths": ["%QML_IMPORT_PATH:;=", "%"],
exit /b 0

rem :backup <file> - moves a file not created by this script to <file>.bak.
:backup
if not exist "%~1" exit /b 0
findstr /l /c:"%GENERATED_BY%" "%~1" >nul 2>&1 && exit /b 0
move /y "%~1" "%~1.bak" >nul
echo Kept the previous %~1 as %~1.bak
exit /b 0

rem :tasks <preset> <name> <isDefault> <separator> - configure, build, and rebuild tasks for one preset.
rem Ninja needs cl.exe and INCLUDE / LIB, so every command goes through vsenv.cmd.
:tasks
echo         {
echo             "label": "CMake: configure %~2",
echo             "type": "process",
echo             "command": "${workspaceFolder}/scripts/vsenv.cmd",
echo             "args": ["cmake", "--preset", "%~1"],
echo             "options": {"cwd": "${workspaceFolder}"},
echo             "problemMatcher": []
echo         },
echo         {
echo             "label": "CMake: build %~2",
echo             "type": "process",
echo             "command": "${workspaceFolder}/scripts/vsenv.cmd",
echo             "args": ["cmake", "--build", "--preset", "%~1"],
echo             "options": {"cwd": "${workspaceFolder}"},
echo             "group": {"kind": "build", "isDefault": %~3},
echo             "problemMatcher": ["$msCompile"]
echo         },
echo         {
echo             "label": "CMake: rebuild %~2",
echo             "type": "process",
echo             "command": "${workspaceFolder}/scripts/vsenv.cmd",
echo             "args": ["cmake", "--build", "--preset", "%~1", "--clean-first"],
echo             "options": {"cwd": "${workspaceFolder}"},
echo             "group": "build",
echo             "problemMatcher": ["$msCompile"]
echo         }%~4
exit /b 0

rem :launch <preset> <name> - debug the preset executable; builds it before launch.
:launch
echo         {
echo             "name": "%PROJECT_NAME% (%~2)",
echo             "type": "cppvsdbg",
echo             "request": "launch",
echo             "preLaunchTask": "CMake: build %~2",
echo             "program": "${workspaceFolder}/build/%~1/%PROJECT_NAME%.exe",
echo             "args": [],
echo             "cwd": "${workspaceFolder}/build/%~1",
echo             "stopAtEntry": false,
echo             "console": "integratedTerminal",
echo             "environment": []
echo         },
exit /b 0
